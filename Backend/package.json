{
  "name": "backend",
  "version": "2.1.0",
  "description": "Backend da aplicacao Verificador de Ping",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext js,mjs,cjs src/server.js",
    "start": "node src/server.js",
    "start:packaged": "node src/server.js --packaged",
    "build:frontend": "npm --prefix ../Frontend run build",
    "webapp": "npm run build:frontend && npm run start:packaged",
    "check": "node --check src/server.js"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "mongoose": "^8.19.2",
    "ping": "^1.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  }
}
