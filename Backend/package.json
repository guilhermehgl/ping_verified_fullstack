{
  "name": "backend",
  "version": "2.1.0",
  "description": "Backend da aplicacao Verificador de Ping",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext js,mjs,cjs src/server.js --local",
    "start": "node src/server.js",
    "start:packaged": "node src/server.js --local --packaged",
    "build:frontend": "npm --prefix ../Frontend run build",
    "webapp": "npm run build:frontend && npm run start:packaged",
    "check": "node scripts/check.js",
    "start:local": "node src/server.js --local",
    "test": "vitest run"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "mongoose": "^8.19.2",
    "ping": "^1.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.11",
    "vitest": "^3.2.7"
  }
}
